# Flutterize Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=<your-root-password>
DB_HOST=db
DB_PORT=3306
DB_USER=flutterize_api
DB_PASS=<your-api-password>
DB_NAME=flutterize

# JWT
JWT_SECRET=<your-jwt-secret>

# TLS
TLS_CERT=/app/certs/server.pem
TLS_KEY=/app/certs/server-key.pem

# Services
SMTP_HOST=mockmail
SMTP_PORT=2525
SMS_GATEWAY_URL=http://mocksms:7600
SERVER_PORT=8443

# Seed users
SEED_ADMIN_EMAIL=admin@flutterize.lab
SEED_ADMIN_PHONE=081234567890
SEED_ADMIN_PASSWORD=<your-admin-password>
SEED_ADMIN_POINTS=1000

SEED_USER_EMAIL=user@flutterize.lab
SEED_USER_PHONE=081234567891
SEED_USER_PASSWORD=<your-user-password>
SEED_USER_POINTS=500
